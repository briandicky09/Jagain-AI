{
    "version": 2,
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "regions": ["sin1"],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "maxDuration": 60
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/build/$1"
        },
        {
            "src": "/(favicon\\.(ico|svg)|apple-touch-icon\\.png|robots\\.txt)",
            "dest": "/$1"
        },
        {
            "src": "/(images|img|storage)/(.*)",
            "dest": "/$1/$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_NAME": "JAGAIN",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "DEV_AUTO_LOGIN": "false",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "warning",
        "LARAVEL_STORAGE_PATH": "/tmp/storage",
        "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
        "CACHE_STORE": "file",
        "SESSION_DRIVER": "cookie",
        "SESSION_SECURE_COOKIE": "true",
        "SESSION_HTTP_ONLY": "true",
        "SESSION_SAME_SITE": "lax",
        "DB_CONNECTION": "pgsql",
        "DB_SSLMODE": "require",
        "INERTIA_SSR_ENABLED": "false"
    }
}
