AI_APP_NAME="JAGAIN AI Microservice"
AI_ENV=development
AI_LOG_LEVEL=INFO
# Required in production (minimum 32 chars, e.g. openssl rand -hex 32)
AI_SERVICE_SECRET=

# Backends:
# - Embedding: "sentence_transformer" (384-dim real ML) or "lightweight" (offline test fallback)
AI_EMBEDDING_BACKEND=sentence_transformer
AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# - Vision: "clip" (openai/clip-vit-base-patch32), "siglip", or "unavailable"
AI_VISION_BACKEND=clip
AI_VISION_MODEL=openai/clip-vit-base-patch32
AI_PRELOAD_MODELS=false

# - NER / PII: "heuristic" (regex + Indonesian contextual NER) or "transformers"
AI_NER_BACKEND=heuristic
AI_NER_MODEL=cahya/bert-base-indonesian-NER

AI_MAX_IMAGE_BYTES=5242880
AI_MAX_REQUEST_BYTES=10485760
AI_RATE_LIMIT_PER_MINUTE=120

# Optional PostgreSQL + pgvector / PostGIS connection string
DATABASE_URL=

# Deduplication scoring weights & thresholds
AI_DEDUP_WEIGHT_SEMANTIC=0.50
AI_DEDUP_WEIGHT_GEO=0.30
AI_DEDUP_WEIGHT_TIME=0.15
AI_DEDUP_WEIGHT_CATEGORY=0.05
AI_DEDUP_LIKELY_THRESHOLD=0.78
AI_DEDUP_POSSIBLE_THRESHOLD=0.55
AI_DEDUP_MAX_RADIUS_METERS=25000
AI_DEDUP_MAX_TIME_MINUTES=4320
